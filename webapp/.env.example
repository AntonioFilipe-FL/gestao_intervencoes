# --- Base de dados (Railway > serviço Postgres > Variables) ---
# Local: usar o DATABASE_PUBLIC_URL do Postgres.
# No serviço da app no Railway: DATABASE_URL=${{Postgres.DATABASE_URL}} (rede privada)
DATABASE_URL=postgresql://postgres:password@host:port/railway

# --- Sessão ---
# Gerar com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials > OAuth client ID "Web application") ---
# Authorized redirect URIs:
#   http://localhost:3000/auth/callback
#   https://<a-tua-app>.up.railway.app/auth/callback
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# URL pública da app (sem / no fim). Local: http://localhost:3000
APP_URL=http://localhost:3000

# Emails que ficam admin automaticamente no primeiro login (separados por vírgula)
ADMIN_EMAILS=

# Email automático quando "Faturar = Sim" (enviado pela conta Google de quem grava o registo).
# Destinatário(s), separados por vírgula. Por omissão: financeira@pt.frotcom.com
BILLING_EMAIL_TO=financeira@pt.frotcom.com
